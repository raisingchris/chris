{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pip3 install --quiet jinja2 markdown-it-py python-frontmatter pyyaml",
  "buildCommand": "python3 site/build.py",
  "outputDirectory": "site/out",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/llms(.*).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/raw/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ]
}
